{
  "$defs": {
    "AllPredicate": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "all",
          "title": "Kind",
          "type": "string"
        },
        "terms": {
          "items": {
            "$ref": "#/$defs/BlockPredicate"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Terms",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "terms"
      ],
      "title": "AllPredicate",
      "type": "object"
    },
    "AnyPredicate": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "any",
          "title": "Kind",
          "type": "string"
        },
        "terms": {
          "items": {
            "$ref": "#/$defs/BlockPredicate"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Terms",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "terms"
      ],
      "title": "AnyPredicate",
      "type": "object"
    },
    "AssignmentConfig": {
      "additionalProperties": false,
      "properties": {
        "constraint": {
          "$ref": "#/$defs/AssignmentConstraint"
        },
        "deterministic_tie_breaking": {
          "const": true,
          "default": true,
          "title": "Deterministic Tie Breaking",
          "type": "boolean"
        },
        "no_match": {
          "$ref": "#/$defs/NoMatchAssignmentConfig"
        },
        "solver": {
          "enum": [
            "ortools_min_cost_flow",
            "unconstrained"
          ],
          "title": "Solver",
          "type": "string"
        }
      },
      "required": [
        "solver",
        "constraint",
        "no_match"
      ],
      "title": "AssignmentConfig",
      "type": "object"
    },
    "AssignmentConstraint": {
      "enum": [
        "one_to_one",
        "many_to_one",
        "one_to_many",
        "unconstrained"
      ],
      "type": "string"
    },
    "BlockPredicate": {
      "discriminator": {
        "mapping": {
          "all": "#/$defs/AllPredicate",
          "any": "#/$defs/AnyPredicate",
          "date_window": "#/$defs/DateWindowPredicate",
          "exact": "#/$defs/ExactPredicate",
          "prefix_equal": "#/$defs/PrefixEqualPredicate"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/ExactPredicate"
        },
        {
          "$ref": "#/$defs/PrefixEqualPredicate"
        },
        {
          "$ref": "#/$defs/DateWindowPredicate"
        },
        {
          "$ref": "#/$defs/AllPredicate"
        },
        {
          "$ref": "#/$defs/AnyPredicate"
        }
      ]
    },
    "BlockingConfig": {
      "additionalProperties": false,
      "properties": {
        "rules": {
          "items": {
            "$ref": "#/$defs/BlockingRuleConfig"
          },
          "maxItems": 128,
          "minItems": 1,
          "title": "Rules",
          "type": "array"
        }
      },
      "required": [
        "rules"
      ],
      "title": "BlockingConfig",
      "type": "object"
    },
    "BlockingRuleConfig": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/Identifier"
        },
        "predicate": {
          "$ref": "#/$defs/BlockPredicate"
        }
      },
      "required": [
        "id",
        "predicate"
      ],
      "title": "BlockingRuleConfig",
      "type": "object"
    },
    "BoostedTreeModelConfig": {
      "additionalProperties": false,
      "properties": {
        "column_sample": {
          "default": 1.0,
          "exclusiveMinimum": 0.0,
          "maximum": 1.0,
          "title": "Column Sample",
          "type": "number"
        },
        "deterministic_mode": {
          "const": true,
          "default": true,
          "title": "Deterministic Mode",
          "type": "boolean"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "hard_negative_fraction": {
          "$ref": "#/$defs/Probability",
          "default": 0.75
        },
        "implementation": {
          "enum": [
            "xgboost_classifier",
            "lightgbm_classifier"
          ],
          "title": "Implementation",
          "type": "string"
        },
        "learning_rate": {
          "default": 0.05,
          "exclusiveMinimum": 0.0,
          "maximum": 1.0,
          "title": "Learning Rate",
          "type": "number"
        },
        "max_depth": {
          "default": 5,
          "exclusiveMinimum": 0,
          "maximum": 32,
          "title": "Max Depth",
          "type": "integer"
        },
        "maximum_training_pairs": {
          "default": 1000000,
          "exclusiveMinimum": 0,
          "maximum": 10000000,
          "title": "Maximum Training Pairs",
          "type": "integer"
        },
        "model_id": {
          "$ref": "#/$defs/Identifier"
        },
        "n_estimators": {
          "default": 300,
          "exclusiveMinimum": 0,
          "maximum": 5000,
          "title": "N Estimators",
          "type": "integer"
        },
        "n_jobs": {
          "const": 1,
          "default": 1,
          "title": "N Jobs",
          "type": "integer"
        },
        "require_verified_labels": {
          "const": true,
          "default": true,
          "title": "Require Verified Labels",
          "type": "boolean"
        },
        "subsample": {
          "default": 1.0,
          "exclusiveMinimum": 0.0,
          "maximum": 1.0,
          "title": "Subsample",
          "type": "number"
        }
      },
      "required": [
        "implementation",
        "model_id"
      ],
      "title": "BoostedTreeModelConfig",
      "type": "object"
    },
    "CalibrationConfig": {
      "additionalProperties": false,
      "properties": {
        "method": {
          "enum": [
            "sigmoid",
            "isotonic"
          ],
          "title": "Method",
          "type": "string"
        },
        "partition": {
          "const": "calibration",
          "default": "calibration",
          "title": "Partition",
          "type": "string"
        },
        "require_independent_partition": {
          "const": true,
          "default": true,
          "title": "Require Independent Partition",
          "type": "boolean"
        },
        "source_model": {
          "$ref": "#/$defs/Identifier"
        }
      },
      "required": [
        "method",
        "source_model"
      ],
      "title": "CalibrationConfig",
      "type": "object"
    },
    "CasefoldTransform": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "casefold",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "CasefoldTransform",
      "type": "object"
    },
    "CategoricalComparison": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "categorical",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "CategoricalComparison",
      "type": "object"
    },
    "CollapseWhitespaceTransform": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "collapse_whitespace",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "CollapseWhitespaceTransform",
      "type": "object"
    },
    "ColumnName": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "ComparisonConfig": {
      "additionalProperties": false,
      "properties": {
        "function": {
          "$ref": "#/$defs/ComparisonFunction"
        },
        "id": {
          "$ref": "#/$defs/Identifier"
        },
        "levels": {
          "items": {
            "$ref": "#/$defs/ComparisonLevel"
          },
          "maxItems": 32,
          "minItems": 2,
          "title": "Levels",
          "type": "array"
        },
        "variable": {
          "$ref": "#/$defs/Identifier"
        }
      },
      "required": [
        "id",
        "variable",
        "function",
        "levels"
      ],
      "title": "ComparisonConfig",
      "type": "object"
    },
    "ComparisonFunction": {
      "discriminator": {
        "mapping": {
          "categorical": "#/$defs/CategoricalComparison",
          "damerau_levenshtein": "#/$defs/DamerauLevenshteinComparison",
          "date_difference": "#/$defs/DateDifferenceComparison",
          "exact": "#/$defs/ExactComparison",
          "jaro_winkler": "#/$defs/JaroWinklerComparison",
          "levenshtein": "#/$defs/LevenshteinComparison",
          "numeric_difference": "#/$defs/NumericDifferenceComparison",
          "qgram": "#/$defs/QGramComparison"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/ExactComparison"
        },
        {
          "$ref": "#/$defs/JaroWinklerComparison"
        },
        {
          "$ref": "#/$defs/LevenshteinComparison"
        },
        {
          "$ref": "#/$defs/DamerauLevenshteinComparison"
        },
        {
          "$ref": "#/$defs/QGramComparison"
        },
        {
          "$ref": "#/$defs/DateDifferenceComparison"
        },
        {
          "$ref": "#/$defs/NumericDifferenceComparison"
        },
        {
          "$ref": "#/$defs/CategoricalComparison"
        }
      ]
    },
    "ComparisonLevel": {
      "discriminator": {
        "mapping": {
          "else": "#/$defs/ElseLevel",
          "exact": "#/$defs/ExactLevel",
          "maximum_difference": "#/$defs/MaximumDifferenceLevel",
          "missing": "#/$defs/MissingLevel",
          "threshold": "#/$defs/ThresholdLevel"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/MissingLevel"
        },
        {
          "$ref": "#/$defs/ExactLevel"
        },
        {
          "$ref": "#/$defs/ThresholdLevel"
        },
        {
          "$ref": "#/$defs/MaximumDifferenceLevel"
        },
        {
          "$ref": "#/$defs/ElseLevel"
        }
      ]
    },
    "ConfirmedDecisionConfig": {
      "additionalProperties": false,
      "properties": {
        "minimum_probability": {
          "$ref": "#/$defs/Probability"
        },
        "minimum_probability_margin": {
          "$ref": "#/$defs/Probability"
        },
        "require_assignment": {
          "default": true,
          "title": "Require Assignment",
          "type": "boolean"
        },
        "require_valid_calibration": {
          "const": true,
          "default": true,
          "title": "Require Valid Calibration",
          "type": "boolean"
        }
      },
      "required": [
        "minimum_probability",
        "minimum_probability_margin"
      ],
      "title": "ConfirmedDecisionConfig",
      "type": "object"
    },
    "DamerauLevenshteinComparison": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "damerau_levenshtein",
          "title": "Kind",
          "type": "string"
        },
        "maximum_distance": {
          "anyOf": [
            {
              "maximum": 1024,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximum Distance"
        }
      },
      "required": [
        "kind"
      ],
      "title": "DamerauLevenshteinComparison",
      "type": "object"
    },
    "DataType": {
      "enum": [
        "string",
        "date",
        "integer",
        "float",
        "boolean",
        "categorical"
      ],
      "type": "string"
    },
    "DatasetConfig": {
      "additionalProperties": false,
      "properties": {
        "format": {
          "enum": [
            "parquet",
            "csv",
            "tsv",
            "jsonl",
            "duckdb"
          ],
          "title": "Format",
          "type": "string"
        },
        "id": {
          "$ref": "#/$defs/Identifier"
        },
        "path": {
          "$ref": "#/$defs/PathText"
        },
        "record_id_column": {
          "$ref": "#/$defs/ColumnName"
        },
        "role": {
          "enum": [
            "source",
            "target",
            "reference",
            "auxiliary"
          ],
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "id",
        "role",
        "path",
        "format",
        "record_id_column"
      ],
      "title": "DatasetConfig",
      "type": "object"
    },
    "DateDifferenceComparison": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "date_difference",
          "title": "Kind",
          "type": "string"
        },
        "unit": {
          "default": "day",
          "enum": [
            "day",
            "month",
            "year"
          ],
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "DateDifferenceComparison",
      "type": "object"
    },
    "DateWindowPredicate": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "date_window",
          "title": "Kind",
          "type": "string"
        },
        "maximum_days": {
          "exclusiveMinimum": 0,
          "maximum": 36525,
          "title": "Maximum Days",
          "type": "integer"
        },
        "variable": {
          "$ref": "#/$defs/Identifier"
        }
      },
      "required": [
        "kind",
        "variable",
        "maximum_days"
      ],
      "title": "DateWindowPredicate",
      "type": "object"
    },
    "DecisionPolicyConfig": {
      "additionalProperties": false,
      "properties": {
        "confirmed": {
          "$ref": "#/$defs/ConfirmedDecisionConfig"
        },
        "no_match": {
          "$ref": "#/$defs/NoMatchDecisionConfig"
        },
        "review_required": {
          "$ref": "#/$defs/ReviewDecisionConfig"
        },
        "unresolved": {
          "$ref": "#/$defs/UnresolvedDecisionConfig"
        }
      },
      "required": [
        "confirmed",
        "review_required",
        "no_match",
        "unresolved"
      ],
      "title": "DecisionPolicyConfig",
      "type": "object"
    },
    "DeterministicAnchorConfig": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "evidence_only",
          "default": "evidence_only",
          "title": "Action",
          "type": "string"
        },
        "allow_as_training_truth": {
          "const": false,
          "default": false,
          "title": "Allow As Training Truth",
          "type": "boolean"
        },
        "id": {
          "$ref": "#/$defs/Identifier"
        },
        "predicate": {
          "$ref": "#/$defs/BlockPredicate"
        },
        "require_unique_left": {
          "default": true,
          "title": "Require Unique Left",
          "type": "boolean"
        },
        "require_unique_right": {
          "default": true,
          "title": "Require Unique Right",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "predicate"
      ],
      "title": "DeterministicAnchorConfig",
      "type": "object"
    },
    "ElseLevel": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "else",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "ElseLevel",
      "type": "object"
    },
    "ExactComparison": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "exact",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "ExactComparison",
      "type": "object"
    },
    "ExactLevel": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "exact",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "ExactLevel",
      "type": "object"
    },
    "ExactPredicate": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "exact",
          "title": "Kind",
          "type": "string"
        },
        "variable": {
          "$ref": "#/$defs/Identifier"
        }
      },
      "required": [
        "kind",
        "variable"
      ],
      "title": "ExactPredicate",
      "type": "object"
    },
    "FellegiSunterModelConfig": {
      "additionalProperties": false,
      "properties": {
        "em_convergence": {
          "default": 0.0001,
          "exclusiveMinimum": 0.0,
          "maximum": 0.1,
          "title": "Em Convergence",
          "type": "number"
        },
        "em_max_iterations": {
          "default": 25,
          "exclusiveMinimum": 0,
          "maximum": 1000,
          "title": "Em Max Iterations",
          "type": "integer"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "estimate_m_by_em": {
          "const": true,
          "default": true,
          "title": "Estimate M By Em",
          "type": "boolean"
        },
        "estimate_u_by_random_sampling": {
          "const": true,
          "default": true,
          "title": "Estimate U By Random Sampling",
          "type": "boolean"
        },
        "implementation": {
          "const": "splink_duckdb",
          "title": "Implementation",
          "type": "string"
        },
        "model_id": {
          "$ref": "#/$defs/Identifier"
        },
        "probability_smoothing": {
          "default": 0.5,
          "exclusiveMinimum": 0.0,
          "maximum": 100.0,
          "title": "Probability Smoothing",
          "type": "number"
        },
        "probability_two_random_records_match": {
          "default": 0.0001,
          "exclusiveMaximum": 1.0,
          "exclusiveMinimum": 0.0,
          "title": "Probability Two Random Records Match",
          "type": "number"
        },
        "term_frequency_adjustments": {
          "const": false,
          "default": false,
          "title": "Term Frequency Adjustments",
          "type": "boolean"
        },
        "u_max_pairs": {
          "default": 1000000,
          "exclusiveMinimum": 0,
          "maximum": 10000000000,
          "title": "U Max Pairs",
          "type": "integer"
        }
      },
      "required": [
        "implementation",
        "model_id"
      ],
      "title": "FellegiSunterModelConfig",
      "type": "object"
    },
    "Fraction": {
      "exclusiveMaximum": 1.0,
      "exclusiveMinimum": 0.0,
      "type": "number"
    },
    "FrozenColumnMap": {
      "additionalProperties": {
        "$ref": "#/$defs/ColumnName"
      },
      "propertyNames": {
        "$ref": "#/$defs/Identifier"
      },
      "type": "object"
    },
    "HardNegativeSamplingConfig": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "verified_nonmatches_only": {
          "const": true,
          "default": true,
          "title": "Verified Nonmatches Only",
          "type": "boolean"
        }
      },
      "title": "HardNegativeSamplingConfig",
      "type": "object"
    },
    "Identifier": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$",
      "type": "string"
    },
    "JaroWinklerComparison": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "jaro_winkler",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "JaroWinklerComparison",
      "type": "object"
    },
    "LabelSource": {
      "discriminator": {
        "mapping": {
          "synthetic_truth": "#/$defs/SyntheticTruthSource",
          "unverified_reference": "#/$defs/UnverifiedReferenceSource",
          "verified_gold_standard": "#/$defs/VerifiedGoldStandardSource",
          "verified_human_adjudication": "#/$defs/VerifiedAdjudicationSource"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/SyntheticTruthSource"
        },
        {
          "$ref": "#/$defs/VerifiedAdjudicationSource"
        },
        {
          "$ref": "#/$defs/VerifiedGoldStandardSource"
        },
        {
          "$ref": "#/$defs/UnverifiedReferenceSource"
        }
      ]
    },
    "LabelsConfig": {
      "additionalProperties": false,
      "properties": {
        "permit_unverified_crosswalk": {
          "const": false,
          "default": false,
          "title": "Permit Unverified Crosswalk",
          "type": "boolean"
        },
        "permit_weak_labels_for_training": {
          "const": false,
          "default": false,
          "title": "Permit Weak Labels For Training",
          "type": "boolean"
        },
        "source": {
          "$ref": "#/$defs/LabelSource"
        }
      },
      "required": [
        "source"
      ],
      "title": "LabelsConfig",
      "type": "object"
    },
    "LevenshteinComparison": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "levenshtein",
          "title": "Kind",
          "type": "string"
        },
        "maximum_distance": {
          "anyOf": [
            {
              "maximum": 1024,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximum Distance"
        }
      },
      "required": [
        "kind"
      ],
      "title": "LevenshteinComparison",
      "type": "object"
    },
    "LinkageMode": {
      "enum": [
        "link_only",
        "dedupe_only",
        "link_and_dedupe",
        "multi_source"
      ],
      "type": "string"
    },
    "MaximumDifferenceLevel": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "maximum_difference",
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "integer"
            }
          ],
          "ge": 0,
          "title": "Value"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "title": "MaximumDifferenceLevel",
      "type": "object"
    },
    "MissingLevel": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "missing",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "MissingLevel",
      "type": "object"
    },
    "MissingnessConfig": {
      "additionalProperties": false,
      "properties": {
        "blank_is_missing": {
          "default": true,
          "title": "Blank Is Missing",
          "type": "boolean"
        },
        "comparison_policy": {
          "default": "explicit_missing_level",
          "enum": [
            "explicit_missing_level",
            "ignore_comparison"
          ],
          "title": "Comparison Policy",
          "type": "string"
        }
      },
